# Portfolio RADCAL smoke-test input.
# Species list and namelist structure follow the downloaded Firemodels RADCAL example.
&HEADER TITLE="PORTFOLIO_RADCAL_SMOKE_TEST" CHID="PORTFOLIO_RADCAL_SMOKE_TEST" /

&BAND OMMIN = 50.0
      OMMAX = 10000.0 /
&WALL TWALL = 500.0 /

&PATH_SEGMENT
    T        = 300.0
    LENGTH   = 0.3175
    PRESSURE = 1.0
    XC2H4    = 0.01
    XCO2     = 0.0033
    XH2O     = 0.01
    XO2      = 0.21
    XN2      = 0.7667
    FV       = 1.0E-7 /
